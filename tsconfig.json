{
  // 这份配置的每一项都在 chapters/00-setup/03-tsconfig.md 里有解释。
  "compilerOptions": {
    /* 语言与运行环境 */
    "target": "es2025",
    "lib": ["es2025"],
    "types": ["node"],

    /* 模块：按 Node.js 的规则解析 import */
    "module": "nodenext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    // 导入工作区里的包时，直接使用它的源码而不是编译产物（4.2 节的自定义条件，4.9 节的项目）
    "customConditions": ["@learn-ts/source"],

    /* 只做类型检查，不输出 .js（代码由 node / tsx / vitest 直接运行） */
    "noEmit": true,

    /* 严格程度：strict 全开，再加几项更严格的检查 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* 其他 */
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  // 类型练习的测试在做完之前一定报错，由 `pnpm ex` 单独检查（见 exercises/tsconfig.json）
  "exclude": ["node_modules", "**/dist", "exercises/**/*.test-d.ts", ".solutions-typecheck"]
}

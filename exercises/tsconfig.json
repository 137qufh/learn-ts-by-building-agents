{
  // 练习目录专用的配置：和根目录的 tsconfig.json 完全相同，只是额外包含了类型测试（*.test-d.ts）。
  //
  // 为什么要分开？类型练习在你做完之前，它的类型测试一定是报错的（这正是"测试失败"）。
  // 根目录的 `pnpm typecheck` 要保证整个仓库永远是绿的，所以它排除了类型测试；
  // 而编辑器打开练习文件时会使用离它最近的这份配置，让你直接在代码里看到红色波浪线。
  // `pnpm ex` 也用这份配置来运行类型测试。
  "extends": "../tsconfig.json",
  "include": ["**/*.ts"],
  // 必须显式写出来：否则会继承根配置的 exclude，而那里恰好排除了类型测试
  "exclude": []
}

{
  "name": "@learn-ts/agent-kit",
  "version": "0.3.0",
  "private": true,
  "description": "第 2、3、5、6 章的工具注册表、流式模型客户端、基于 Zod 的工具定义和 agent harness，打包成一个可以复用的包。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@learn-ts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "@learn-ts/source": "./src/zod/index.ts",
      "types": "./dist/zod/index.d.ts",
      "default": "./dist/zod/index.js"
    },
    "./testing": {
      "@learn-ts/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript7": "npm:typescript@^7.0.2",
    "zod": "^4.6.7"
  }
}
